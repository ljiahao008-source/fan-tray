<Application x:Class="MonitoringApp.Tray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 精简版浅色配色（与旧版一致的 Fluent 色值） -->
            <SolidColorBrush x:Key="BgBrush" Color="#EDF0F4" />
            <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BorderBrush" Color="#E1E6ED" />
            <SolidColorBrush x:Key="TextBrush" Color="#1B2430" />
            <SolidColorBrush x:Key="TextDimBrush" Color="#6B7686" />
            <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
