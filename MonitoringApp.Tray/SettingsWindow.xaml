<Window x:Class="MonitoringApp.Tray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
  <StackPanel Margin="28">
    <TextBlock Text="设置" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />

    <TextBlock Text="数据刷新间隔" Margin="0,22,0,6" Foreground="{StaticResource TextDimBrush}" FontSize="13" />
    <ComboBox x:Name="IntervalCombo" />

    <CheckBox x:Name="AutoStart" Content="开机自启（登录 Windows 后自动在后台运行）" Margin="0,18,0,0" Foreground="{StaticResource TextBrush}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,8">
      <Button x:Name="CancelBtn" Content="取消" Padding="20,8" Margin="0,0,10,0" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Click="OnCancel" />
      <Button x:Name="OkBtn" Content="确定" Padding="20,8" Background="{StaticResource AccentBrush}" Foreground="#FFFFFF" Click="OnOk" />
    </StackPanel>
  </StackPanel>
</Window>
