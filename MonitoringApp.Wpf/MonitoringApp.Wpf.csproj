<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MechrevoMonitor</AssemblyName>
    <RootNamespace>MonitoringApp</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>2.0.0</Version>
    <ApplicationIcon>..\MonitoringApp\app.ico</ApplicationIcon>
    <ApplicationManifest>..\MonitoringApp\app.manifest</ApplicationManifest>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LibreHardwareMonitorLib\LibreHardwareMonitorLib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\MonitoringApp\PowerHistory.cs" Link="PowerHistory.cs" />
    <Compile Include="..\MonitoringApp\AppSettings.cs" Link="AppSettings.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>
</Project>
