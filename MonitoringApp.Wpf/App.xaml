<Application x:Class="MonitoringApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources RequestedTheme="Light" />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- Fluent Light 全局配色 -->
            <SolidColorBrush x:Key="BgBrush" Color="#EDF0F4" />          <!-- 窗口冷灰底 -->
            <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />       <!-- 卡片白 -->
            <SolidColorBrush x:Key="BorderBrush" Color="#E1E6ED" />      <!-- 浅边框 -->
            <SolidColorBrush x:Key="TextBrush" Color="#1B2430" />        <!-- 主文字 -->
            <SolidColorBrush x:Key="TextDimBrush" Color="#6B7686" />     <!-- 次要文字 -->

            <!-- UI 主色：Fluent 蓝（选中态、强调） -->
            <SolidColorBrush x:Key="CyanBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />

            <!-- 指标语义色（白底 600 级，保证对比度） -->
            <SolidColorBrush x:Key="PowerBrush" Color="#EA580C" />       <!-- 功耗：橙 -->
            <SolidColorBrush x:Key="FanBrush" Color="#0D9488" />         <!-- 风扇：青 -->
            <SolidColorBrush x:Key="MemBrush" Color="#DB2777" />         <!-- 内存：玫红 -->
            <SolidColorBrush x:Key="DownBrush" Color="#2563EB" />        <!-- 下行：蓝 -->
            <SolidColorBrush x:Key="UpBrush" Color="#7C3AED" />          <!-- 上行：紫 -->
            <SolidColorBrush x:Key="GreenBrush" Color="#16A34A" />       <!-- 正常/确定：绿 -->
            <SolidColorBrush x:Key="RedBrush" Color="#DC2626" />         <!-- 危险：红 -->
            <SolidColorBrush x:Key="OrangeBrush" Color="#D97706" />      <!-- 警告：琥珀 -->
            <SolidColorBrush x:Key="YellowBrush" Color="#CA8A04" />
            <SolidColorBrush x:Key="BlueBrush" Color="#DB2777" />        <!-- 兼容旧键（内存语义=玫红） -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
