<Window x:Class="MonitoringApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="机械革命硬件监控"
        Width="880" Height="820"
        MinWidth="760" MinHeight="720"
        FontFamily="Microsoft YaHei UI"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">

  <Window.Resources>
    <!-- 白卡片：浅边框 + 极柔和阴影 -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#1F2937" BlurRadius="14" ShadowDepth="1" Opacity="0.07" />
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CardValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style x:Key="CardSub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>

    <!-- 指标/粒度切换片 -->
    <Style x:Key="ChipBtn" TargetType="Button">
      <Setter Property="Background" Value="#EDF0F4" />
      <Setter Property="Foreground" Value="#4B5563" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
              <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                         FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E2E8F0" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#CBD5E1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 标题栏幽灵按钮 -->
    <Style x:Key="GhostBtn" TargetType="Button">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#D6DCE5" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#F3F6FA" />
                <Setter TargetName="bd" Property="BorderBrush" Value="#C3CDDA" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E9EEF5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 日历翻月按钮 -->
    <Style x:Key="NavBtn" TargetType="Button">
      <Setter Property="Background" Value="#EDF0F4" />
      <Setter Property="Foreground" Value="#4B5563" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="0,4" Width="28">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E2E8F0" />
                <Setter Property="Foreground" Value="#1B2430" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#CBD5E1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="1.1*" />
      <RowDefinition Height="2.4*" />
      <RowDefinition Height="1.6*" />
    </Grid.RowDefinitions>

    <!-- 标题栏 -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="⚡" FontSize="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
        <TextBlock Text="硬件监控" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
        <TextBlock x:Name="ClockText" Text="" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="18,2,0,0" />
      </StackPanel>

      <!-- 实时网速（下行/上行），Trend = 曲线图里切"下行/上行" -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
        <TextBlock x:Name="NetDownText" Text="↓ --" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource DownBrush}" VerticalAlignment="Center"
                   ToolTip="下行速度（KB/s）&#10;会话累计下载量会在悬停提示中实时显示" />
        <TextBlock Text="  |  " Foreground="#C3CAD6" VerticalAlignment="Center" />
        <TextBlock x:Name="NetUpText" Text="↑ --" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource UpBrush}" VerticalAlignment="Center"
                   ToolTip="上行速度（KB/s）&#10;单击曲线区按钮可查看下行/上行历史曲线" />
      </StackPanel>

      <Button Grid.Column="2" Content="⚙ 设置" VerticalAlignment="Center" Padding="15,7"
              Style="{StaticResource GhostBtn}" Click="OnSettings" />
    </Grid>

    <!-- 卡片行 -->
    <Grid Grid.Row="1" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
        <StackPanel Margin="16,13">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource PowerBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="CPU 功耗 (W)" Style="{StaticResource CardTitle}" />
          </StackPanel>
          <TextBlock x:Name="PowerValue" Text="--" Style="{StaticResource CardValue}" Foreground="{StaticResource PowerBrush}" Margin="0,7,0,3" />
          <TextBlock x:Name="PowerSub" Text="最低 -- · 最高 -- · 平均 --" Style="{StaticResource CardSub}" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
        <StackPanel Margin="16,13">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center" x:Name="TempDot" />
            <TextBlock x:Name="TempTitle" Text="CPU 温度 (℃)" Style="{StaticResource CardTitle}" />
          </StackPanel>
          <TextBlock x:Name="TempValue" Text="--" Style="{StaticResource CardValue}" Foreground="{StaticResource GreenBrush}" Margin="0,7,0,3" />
          <TextBlock x:Name="TempSub" Text="最低 -- · 最高 -- · 平均 --" Style="{StaticResource CardSub}" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,10,0">
        <StackPanel Margin="16,13">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource FanBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="风扇转速 (RPM)" Style="{StaticResource CardTitle}" />
          </StackPanel>
          <TextBlock x:Name="FanValue" Text="--" Style="{StaticResource CardValue}" Foreground="{StaticResource FanBrush}" Margin="0,7,0,3" />
          <TextBlock x:Name="FanSub" Text="最低 -- · 最高 -- · 平均 --" Style="{StaticResource CardSub}" />
        </StackPanel>
      </Border>

      <Border Grid.Column="3" Style="{StaticResource Card}">
        <StackPanel Margin="16,13">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource MemBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="内存占用 (%)" Style="{StaticResource CardTitle}" />
          </StackPanel>
          <TextBlock x:Name="MemValue" Text="--" Style="{StaticResource CardValue}" Foreground="{StaticResource MemBrush}" Margin="0,7,0,3" />
          <TextBlock x:Name="MemSub" Text="最低 -- · 最高 -- · 平均 --" Style="{StaticResource CardSub}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- 曲线图 -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
      <DockPanel Margin="2">
        <WrapPanel DockPanel.Dock="Top" Margin="12,10,12,4">
          <TextBlock Text="历史曲线" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
          <TextBlock Text="指标" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
          <Button x:Name="BtnPower" Content="功耗" Tag="Power" Style="{StaticResource ChipBtn}" Padding="13,4" Click="OnMetricClick" ToolTip="CPU 封装功耗（W）" />
          <Button x:Name="BtnTemp" Content="温度" Tag="Temperature" Style="{StaticResource ChipBtn}" Padding="13,4" Click="OnMetricClick" ToolTip="CPU 温度（℃）" />
          <Button x:Name="BtnFan" Content="风扇" Tag="Fan" Style="{StaticResource ChipBtn}" Padding="13,4" Click="OnMetricClick" ToolTip="风扇转速（RPM）" />
          <Button x:Name="BtnMem" Content="内存" Tag="Memory" Style="{StaticResource ChipBtn}" Padding="13,4" Click="OnMetricClick" ToolTip="内存占用（%）" />
          <Button x:Name="BtnNetDown" Content="下行" Tag="NetworkDown" Style="{StaticResource ChipBtn}" Padding="13,4" Click="OnMetricClick" ToolTip="下行速率（KB/s）" />
          <Button x:Name="BtnNetUp" Content="上行" Tag="NetworkUp" Style="{StaticResource ChipBtn}" Padding="13,4" Click="OnMetricClick" Margin="0,0,16,0" ToolTip="上行速率（KB/s）" />
          <TextBlock Text="粒度" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" ToolTip="每个数据点 = 该时间段内的平均值" />
          <Button x:Name="Btn1m" Content="1m" Tag="60" Style="{StaticResource ChipBtn}" Padding="13,4" Click="OnPeriodClick" ToolTip="每 1 分钟聚合一个点" />
          <Button x:Name="Btn5m" Content="5m" Tag="300" Style="{StaticResource ChipBtn}" Padding="13,4" Click="OnPeriodClick" ToolTip="每 5 分钟聚合一个点" />
          <Button x:Name="Btn15m" Content="15m" Tag="900" Style="{StaticResource ChipBtn}" Padding="13,4" Click="OnPeriodClick" ToolTip="每 15 分钟聚合一个点" />
          <Button x:Name="Btn1h" Content="1h" Tag="3600" Style="{StaticResource ChipBtn}" Padding="13,4" Click="OnPeriodClick" ToolTip="每 1 小时聚合一个点" />
          <Button x:Name="Btn4h" Content="4h" Tag="14400" Style="{StaticResource ChipBtn}" Padding="13,4" Click="OnPeriodClick" ToolTip="每 4 小时聚合一个点" />
          <Button x:Name="Btn1d" Content="1d" Tag="86400" Style="{StaticResource ChipBtn}" Padding="13,4" Click="OnPeriodClick" ToolTip="每天聚合一个点" />
        </WrapPanel>
        <sp:WpfPlot x:Name="Plot" Margin="6,2,10,8" />
      </DockPanel>
    </Border>

    <!-- 日历 -->
    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0">
      <Grid Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="28" />
          <RowDefinition Height="*" />
          <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" x:Name="BtnPrevMonth" Content="◀" Click="OnPrevMonth" Style="{StaticResource NavBtn}" ToolTip="上一月" />
          <TextBlock Grid.Column="1" x:Name="CalendarTitle" Text="监控日历" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Button Grid.Column="2" x:Name="BtnNextMonth" Content="▶" Click="OnNextMonth" Style="{StaticResource NavBtn}" ToolTip="下一月" />
        </Grid>
        <UniformGrid Grid.Row="1" x:Name="CalendarGrid" Columns="7" />
        <!-- 功耗图例：冷→暖 = 低→高 -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="低功耗" FontSize="10.5" Foreground="#8A94A3" VerticalAlignment="Center" />
          <Border Grid.Column="1" Height="6" CornerRadius="3" Margin="10,0,10,0" VerticalAlignment="Center" ToolTip="当日平均功耗越高，格子颜色越暖 · 点击日期查看当天四指标">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#E3F0FB" Offset="0.0" />
                <GradientStop Color="#C6E9D4" Offset="0.25" />
                <GradientStop Color="#FCECB0" Offset="0.5" />
                <GradientStop Color="#FDC08A" Offset="0.75" />
                <GradientStop Color="#F26D6D" Offset="1.0" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <TextBlock Text="高功耗" FontSize="10.5" Foreground="#8A94A3" VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
